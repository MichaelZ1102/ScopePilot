# ScopePilot environment configuration
# Copy this file to .env and fill in real values.

# --- Required security ---
SECRET_KEY=your-random-secret-key-here
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# --- Jira configuration ---
# Required when importing Jira sprints through the CLI or default project setup.
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# --- AI provider ---
# Configure at least one provider for AI analysis and API test generation.

# Option 1: OpenCode Go
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_MODEL=deepseek-v4-flash
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Option 2: Groq
# GROQ_API_KEY=gsk_your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: StepFun
# STEPFUN_API_KEY=sk-your-stepfun-key
# STEPFUN_MODEL=step-1-8k
# STEPFUN_BASE_URL=https://api.stepfun.com/v1

# Option 4: OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
