# ScopePilot backend environment configuration
# Copy this file to backend/.env for local backend-only development.
# Docker deployments read the root .env file.

# --- Required security ---
SECRET_KEY=your-random-secret-key-here
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
DEPLOYMENT_ENVIRONMENT=development
# Local repository scans are disabled unless the requested path is inside one
# of these comma-separated roots. Never enable local scans in hosted production.
LOCAL_CODE_SCAN_ROOTS=

# --- Jira configuration ---
# Required when importing Jira sprints through the CLI or default project setup.
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# --- AI provider ---
# Supported providers: opencode, groq, stepfun, openai.
AI_PROVIDER=stepfun
AI_API_KEY=your-ai-api-key
AI_MODEL=step-3.7-flash
AI_BASE_URL=https://api.stepfun.com/step_plan/v1
